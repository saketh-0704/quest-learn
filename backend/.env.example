# This file is resolved relative to backend/, independently of the shell directory.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Supabase Dashboard > Connect / Project Settings > API Keys.
# Fill these in LOCAL backend/.env. Never paste secret values into chat.
# New projects: use sb_publishable_... and sb_secret_... keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only the URL and publishable key are needed for account verification.
# Required for notebook uploads and persistence. Do not use a publishable key here.
SUPABASE_SECRET_KEY=
# Server-only Postgres connection URI, including password (URI-encode special chars).
# Use a session pooler or direct connection (not transaction mode: worker uses session locks).
DATABASE_URL=
STORAGE_BUCKET=study-material
# Gemini text understanding (server only). Never put this key in frontend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TIMEOUT_SECONDS=180
NOTEBOOK_JOB_TIMEOUT_SECONDS=900
# RAG_PYTHON defaults to the isolated Windows worker interpreter under .local/raganything/.

# Hybrid retrieval (server-only). Model-specific similarity calibration is required.
RETRIEVAL__MATCH_COUNT=6
RETRIEVAL__CANDIDATE_COUNT=24
RETRIEVAL__MIN_SIMILARITY=0.35
RETRIEVAL__SEMANTIC_WEIGHT=1
RETRIEVAL__KEYWORD_WEIGHT=1
RETRIEVAL__RRF_K=60
RETRIEVAL__MAX_CONTEXT_CHARS=12000
RETRIEVAL_STATEMENT_TIMEOUT_MS=5000
